---
import { ArrowRight, Cpu } from 'lucide-astro';
---

<section id="holding" class="relative pt-36 pb-20 md:pt-48 md:pb-32 overflow-hidden">
  <!-- Glows de fondo -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-teal-500/10 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute top-1/3 right-10 w-[400px] h-[400px] bg-amber-500/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-teal-500/30 bg-teal-500/10 text-teal-300 text-xs font-semibold uppercase tracking-widest mb-6">
        <Cpu class="w-3.5 h-3.5" /> Convergencia de Tecnología & Recursos Naturales
      </div>

      <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight leading-none mb-6">
        Transformando recursos esenciales en el <span class="bg-gradient-to-r from-teal-400 via-cyan-300 to-amber-300 bg-clip-text text-transparent">futuro de la humanidad.</span>
      </h1>

      <p class="text-lg md:text-xl text-slate-400 font-light leading-relaxed mb-8">
        <strong class="text-slate-200">PearlIAm</strong> (Perla Yo Soy) lidera la transición global integrando inteligencia artificial, autonomía operativa y extracción minera responsable de última generación.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a href="#milenium" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold rounded-xl shadow-lg shadow-amber-500/20 transition">
          Conocer Minera Milenium
          <ArrowRight class="w-4 h-4" />
        </a>
        <a href="#ecosistema" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-slate-900 border border-slate-700 hover:border-slate-500 text-slate-200 font-semibold rounded-xl transition">
          Ver Unidades de Negocio
        </a>
      </div>
    </div>

    <!-- Stats rápida -->
    <div class="mt-20 grid grid-cols-2 md:grid-cols-4 gap-6 pt-10 border-t border-slate-800/80">
      <div>
        <span class="block text-3xl md:text-4xl font-extrabold text-teal-400">100%</span>
        <span class="text-xs uppercase text-slate-400 font-medium tracking-wider">Trazabilidad AI</span>
      </div>
      <div>
        <span class="block text-3xl md:text-4xl font-extrabold text-amber-400">4+</span>
        <span class="text-xs uppercase text-slate-400 font-medium tracking-wider">Divisiones Clave</span>
      </div>
      <div>
        <span class="block text-3xl md:text-4xl font-extrabold text-cyan-400">Zero-Net</span>
        <span class="text-xs uppercase text-slate-400 font-medium tracking-wider">Compromiso Carbono</span>
      </div>
      <div>
        <span class="block text-3xl md:text-4xl font-extrabold text-slate-200">Global</span>
        <span class="text-xs uppercase text-slate-400 font-medium tracking-wider">Proyección y Estándar</span>
      </div>
    </div>
  </div>
</section>