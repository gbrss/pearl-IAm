---
import { ArrowRight, Sparkles } from 'lucide-astro';
---

<section id="holding" class="relative pt-36 pb-20 md:pt-48 md:pb-32 overflow-hidden">
  <!-- Glows de fondo -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-amber-300/20 dark:bg-amber-500/10 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-amber-300 dark:border-amber-500/30 bg-amber-100/60 dark:bg-amber-500/10 text-amber-800 dark:text-amber-300 text-xs font-bold uppercase tracking-widest mb-6">
        <Sparkles class="w-3.5 h-3.5 text-amber-600 dark:text-amber-400" /> Excelencia Corporativa & Innovación
      </div>

      <h1 class="text-4xl md:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-none mb-6">
        Liderazgo estratégico y desarrollo sostenible en el <span class="bg-gradient-to-r from-amber-600 via-amber-500 to-amber-400 dark:from-amber-400 dark:via-amber-300 dark:to-amber-200 bg-clip-text text-transparent">siglo XXI.</span>
      </h1>

      <p class="text-lg md:text-xl text-slate-600 dark:text-slate-300 font-normal leading-relaxed mb-8">
        <strong class="text-amber-700 dark:text-amber-400">PearlIAm</strong> (Perla Yo Soy) impulsa empresas de alto impacto técnico y ambiental, uniendo inteligencia artificial, energías limpias y la sólida gestión de <strong class="text-slate-900 dark:text-white">Minera Milenium</strong>.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a href="#milenium" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white font-bold rounded-xl shadow-lg shadow-amber-500/25 transition transform hover:-translate-y-0.5">
          Conocer Minera Milenium
          <ArrowRight class="w-4 h-4" />
        </a>
        <a href="#ecosistema" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-white dark:bg-slate-900 border border-amber-200 dark:border-slate-800 hover:border-amber-400 text-slate-800 dark:text-slate-200 font-semibold rounded-xl transition shadow-sm">
          Ver Unidades del Holding
        </a>
      </div>
    </div>

    <!-- Stats -->
    <div class="mt-20 grid grid-cols-2 md:grid-cols-4 gap-6 pt-10 border-t border-amber-200/60 dark:border-slate-800">
      <div>
        <span class="block text-3xl md:text-4xl font-extrabold text-amber-600 dark:text-amber-400">100%</span>
        <span class="text-xs uppercase text-slate-500 dark:text-slate-400 font-bold tracking-wider">Trazabilidad AI</span>
      </div>
      <div>
        <span class="block text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white">4+</span>
        <span class="text-xs uppercase text-slate-500 dark:text-slate-400 font-bold tracking-wider">Filiales Clave</span>
      </div>
      <div>
        <span class="block text-3xl md:text-4xl font-extrabold text-amber-600 dark:text-amber-400">ESG</span>
        <span class="text-xs uppercase text-slate-500 dark:text-slate-400 font-bold tracking-wider">Estándar Global</span>
      </div>
      <div>
        <span class="block text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white">Zero-Net</span>
        <span class="text-xs uppercase text-slate-500 dark:text-slate-400 font-bold tracking-wider">Compromiso Carbono</span>
      </div>
    </div>
  </div>
</section>