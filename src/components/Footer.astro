---
import { Gem } from 'lucide-astro';
---

<footer id="contacto" class="bg-white dark:bg-slate-950 border-t border-amber-200/80 dark:border-slate-800 py-12 text-slate-600 dark:text-slate-400 text-xs transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6">
    <div class="flex items-center gap-3">
      <Gem class="w-5 h-5 text-amber-600 dark:text-amber-400" />
      <span class="font-bold text-slate-900 dark:text-white tracking-wider">PEARL<span class="text-amber-600 dark:text-amber-400">IAM</span> HOLDING</span>
    </div>
    
    <p>© {new Date().getFullYear()} PearlIAm Holding. Todos los derechos reservados. Incluye a Minera Milenium y divisiones asociadas.</p>

    <div class="flex gap-6 font-semibold">
      <a href="https://minera-milenium.pages.dev/" target="_blank" class="hover:text-amber-600 dark:hover:text-amber-400 transition">Minera Milenium Live</a>
      <a href="#" class="hover:text-amber-600 dark:hover:text-amber-400 transition">Términos</a>
      <a href="#" class="hover:text-amber-600 dark:hover:text-amber-400 transition">Privacidad</a>
    </div>
  </div>
</footer>