---
import { Gem, Sun, Moon } from 'lucide-astro';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/90 dark:bg-slate-950/90 backdrop-blur-md border-b border-amber-200/60 dark:border-amber-500/20 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
    <!-- Logo Holding -->
    <a href="#" class="flex items-center gap-3 group">
      <div class="flex flex-col">
        <!-- Logo Modo Claro -->
        <img 
          src="/logo-nav.png" 
          alt="Logo Pearl I Am" 
          width="183px;"
          height="40px"
          class="h-[45px] w-auto block dark:hidden object-contain"
        />
        <!-- Logo Modo Oscuro -->
        <img 
          src="/logo-nav-dark.png" 
          alt="Logo Pearl I Am" 
          width="183px;"
          height="40px"
          class="h-[45px] w-auto hidden dark:block object-contain"
        />
      </div>
    </a>

    <!-- Nav Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-700 dark:text-slate-300">
      <a href="#holding" class="hover:text-amber-600 dark:hover:text-amber-400 transition">El Holding</a>
      <a href="#ecosistema" class="hover:text-amber-600 dark:hover:text-amber-400 transition">Ecosistema</a>
      <a href="#milenium" class="text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 transition flex items-center gap-1.5 font-bold">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
        </span>
        Minera Milenium
      </a>
      <a href="#contacto" class="hover:text-amber-600 dark:hover:text-amber-400 transition">Contacto</a>
    </nav>

    <!-- Controls (Theme Toggle & CTA) -->
    <div class="flex items-center gap-4">
      <!-- Toggle Dark/Light Mode Button -->
      <button id="theme-toggle" type="button" aria-label="Cambiar tema" class="p-2.5 rounded-xl border border-amber-200 dark:border-amber-500/30 bg-amber-50/50 dark:bg-slate-900 text-amber-600 dark:text-amber-400 hover:bg-amber-100 dark:hover:bg-slate-800 transition shadow-sm">
        <Sun class="w-4 h-4 hidden dark:block" />
        <Moon class="w-4 h-4 block dark:hidden" />
      </button>

      <a href="#contacto" class="hidden md:inline-flex px-5 py-2.5 text-xs font-bold tracking-wider uppercase bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white rounded-lg shadow-md shadow-amber-500/20 transition transform hover:-translate-y-0.5">
        Contacto Holding
      </a>
    </div>
  </div>
</header>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
</script>