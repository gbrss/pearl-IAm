---
import { Pickaxe, Shield, ExternalLink, Zap } from 'lucide-astro';
---

<section id="milenium" class="py-24 bg-gradient-to-b from-amber-100/40 via-white to-amber-50/20 dark:from-slate-900/80 dark:via-slate-950 dark:to-slate-900/60 relative border-y border-amber-200/60 dark:border-amber-500/20 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Info -->
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-amber-400/40 bg-amber-100/80 dark:bg-amber-500/10 text-amber-800 dark:text-amber-400 text-xs font-bold uppercase tracking-widest mb-4">
          <Pickaxe class="w-3.5 h-3.5 text-amber-600 dark:text-amber-400" /> Subsidiaria Principal
        </div>

        <h2 class="text-3xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-6">
          Minera Milenium
        </h2>

        <p class="text-slate-700 dark:text-slate-300 text-lg leading-relaxed mb-6 font-normal">
          División minera insigne de <strong class="text-amber-600 dark:text-amber-400">PearlIAm Holding</strong>. Especializada en prospección inteligente, extracción sostenible y automatización industrial de alta precisión.
        </p>

        <!-- Atributos -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
          <div class="p-4 rounded-xl bg-white dark:bg-slate-950 border border-amber-200/80 dark:border-slate-800 shadow-sm">
            <Zap class="w-5 h-5 text-amber-600 dark:text-amber-400 mb-2" />
            <h4 class="font-bold text-slate-900 dark:text-white text-sm">Procesos Autónomos</h4>
            <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">Sistemas robóticos de vanguardia y telemetría satelital.</p>
          </div>
          <div class="p-4 rounded-xl bg-white dark:bg-slate-950 border border-amber-200/80 dark:border-slate-800 shadow-sm">
            <Shield class="w-5 h-5 text-amber-600 dark:text-amber-400 mb-2" />
            <h4 class="font-bold text-slate-900 dark:text-white text-sm">Compromiso ESG</h4>
            <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">Eficiencia hídrica circular y extracción baja en emisiones.</p>
          </div>
        </div>

        <a href="https://mineramilenium.cl/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3.5 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white font-bold rounded-xl transition shadow-lg shadow-amber-500/20">
          Visitar Sitio Web Minera Milenium
          <ExternalLink class="w-4 h-4" />
        </a>
      </div>

      <!-- Card Interactivo -->
      <div class="lg:col-span-5">
        <div class="relative p-8 rounded-2xl bg-white dark:bg-slate-950 border-2 border-amber-300 dark:border-amber-500/40 shadow-xl shadow-amber-500/10">
          <div class="absolute -top-3 -right-3 px-3 py-1 bg-gradient-to-r from-amber-500 to-amber-600 text-white text-xs font-black uppercase tracking-wider rounded-md shadow-md">
            Unidad Principal
          </div>
          
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Estado Operativo Milenium</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-6">Métricas sincronizadas en tiempo real con el holding.</p>

          <div class="space-y-4 text-xs">
            <div>
              <div class="flex justify-between text-slate-700 dark:text-slate-300 mb-1 font-semibold">
                <span>Optimización AI de Yacimientos</span>
                <span class="font-bold text-amber-600 dark:text-amber-400">98.4%</span>
              </div>
              <div class="w-full bg-slate-100 dark:bg-slate-800 h-2.5 rounded-full overflow-hidden">
                <div class="bg-gradient-to-r from-amber-500 to-amber-400 h-full w-[98.4%] rounded-full"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-slate-700 dark:text-slate-300 mb-1 font-semibold">
                <span>Eficiencia Hídrica Recirculada</span>
                <span class="font-bold text-amber-600 dark:text-amber-400">92.0%</span>
              </div>
              <div class="w-full bg-slate-100 dark:bg-slate-800 h-2.5 rounded-full overflow-hidden">
                <div class="bg-gradient-to-r from-amber-500 to-amber-400 h-full w-[92%] rounded-full"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-slate-700 dark:text-slate-300 mb-1 font-semibold">
                <span>Seguridad Automatizada</span>
                <span class="font-bold text-amber-600 dark:text-amber-400">100%</span>
              </div>
              <div class="w-full bg-slate-100 dark:bg-slate-800 h-2.5 rounded-full overflow-hidden">
                <div class="bg-gradient-to-r from-amber-500 to-amber-400 h-full w-[100%] rounded-full"></div>
              </div>
            </div>
          </div>

          <div class="mt-8 pt-6 border-t border-amber-200/80 dark:border-slate-800 flex justify-between items-center text-xs text-slate-500 dark:text-slate-400">
            <span>Operación: Continua 24/7</span>
            <span class="text-emerald-600 dark:text-emerald-400 flex items-center gap-1 font-semibold">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Sincronizado
            </span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>