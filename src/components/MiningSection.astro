---
import { Pickaxe, Shield, ExternalLink, Zap } from 'lucide-astro';
---

<section id="milenium" class="py-24 bg-slate-900/60 relative border-y border-slate-800">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Columna Texto e Info -->
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-amber-500/30 bg-amber-500/10 text-amber-400 text-xs font-semibold uppercase tracking-widest mb-4">
          <Pickaxe class="w-3.5 h-3.5" /> Empresa del Holding PearlIAm
        </div>

        <h2 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight mb-6">
          Minera Milenium
        </h2>

        <p class="text-slate-300 text-lg leading-relaxed mb-6">
          Subsidiaria insignia del grupo PearlIAm, redefiniendo la industria minera mediante la integración de prospección inteligente, automatización y procesos sostenibles en tiempo real.
        </p>

        <p class="text-slate-400 mb-8">
          Integrando los estándares del sitio web original de <span class="text-amber-400 font-semibold">Minera Milenium</span> con el respaldo tecnológico y financiero global del holding PearlIAm.
        </p>

        <!-- Métricas / Atributos de Milenium -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
          <div class="p-4 rounded-xl bg-slate-950/80 border border-slate-800">
            <Zap class="w-5 h-5 text-amber-400 mb-2" />
            <h4 class="font-bold text-white text-sm">Extracción Autónoma</h4>
            <p class="text-xs text-slate-400 mt-1">Sistemas robóticos y monitoreo satelital en yacimientos.</p>
          </div>
          <div class="p-4 rounded-xl bg-slate-950/80 border border-slate-800">
            <Shield class="w-5 h-5 text-teal-400 mb-2" />
            <h4 class="font-bold text-white text-sm">Minería Verde (ESG)</h4>
            <p class="text-xs text-slate-400 mt-1">Reducción del footprint hídrico y cero emisiones directas.</p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-4">
          <a href="https://minera-milenium.pages.dev/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-xl transition shadow-lg shadow-amber-500/20">
            Visitar Sitio Web Milenium
            <ExternalLink class="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Columna Card Interactivo / Visual -->
      <div class="lg:col-span-5">
        <div class="relative p-8 rounded-2xl bg-gradient-to-b from-slate-950 to-slate-900 border border-amber-500/30 shadow-2xl shadow-amber-500/5">
          <div class="absolute -top-3 -right-3 px-3 py-1 bg-amber-500 text-slate-950 text-xs font-black uppercase tracking-wider rounded-md">
            Unidad Principal
          </div>
          
          <h3 class="text-xl font-bold text-white mb-2">Panel Operativo Milenium</h3>
          <p class="text-xs text-slate-400 mb-6">Métricas de rendimiento sincronizadas con PearlIAm Core.</p>

          <div class="space-y-4 text-xs">
            <div>
              <div class="flex justify-between text-slate-300 mb-1">
                <span>Optimización AI de Yacimientos</span>
                <span class="font-bold text-amber-400">98.4%</span>
              </div>
              <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
                <div class="bg-amber-400 h-full w-[98.4%] rounded-full"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-slate-300 mb-1">
                <span>Eficiencia Hídrica Recirculada</span>
                <span class="font-bold text-teal-400">92.0%</span>
              </div>
              <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
                <div class="bg-teal-400 h-full w-[92%] rounded-full"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-slate-300 mb-1">
                <span>Seguridad Automatizada</span>
                <span class="font-bold text-cyan-400">100%</span>
              </div>
              <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
                <div class="bg-cyan-400 h-full w-[100%] rounded-full"></div>
              </div>
            </div>
          </div>

          <div class="mt-8 pt-6 border-t border-slate-800 flex justify-between items-center text-xs text-slate-400">
            <span>Estado: Operativo 24/7</span>
            <span class="text-emerald-400 flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Sincronizado
            </span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>